# OAuth and App URLs
REDIRECT_URI=https://backend.quemailer.com/google/callback
BASE_URL=https://
FRONTEND_AUTH_URL=https://www.quemailer.com/auth
GOOGLE_API_IP_URL=https://api.ipify.org?format=json
GOOGLE_OAUTH_PLAYGROUND=https://developers.google.com/oauthplayground
GOOGLE_CALLBACK_LOCAL=http://localhost:5000/google/callback
GOOGLE_LOGOUT_URL=https://accounts.google.com/logout
GOOGLE_REVOKE_URL=https://oauth2.googleapis.com/revoke
GMAIL_API_PROFILE=https://gmail.googleapis.com/gmail/v1/users/me/profile

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=app_user
DB_PASSWORD=app_password
DB_NAME=email_marketing
DB_DIALECT=mysql

# Environment
NODE_ENV=development

# Session Secret
SESSION_SECRET=your-secret-key-here-please-change-this-in-production

# CORS Configuration
CORS_WHITELIST=http://localhost:3000,http://localhost:5000,https://www.quemailer.com