<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OTP</title>
  </head>
  <body>
    <div
      style="
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
      "
    >

      <img src="../../qm-logo.png" alt="" srcset="" />
      <h2>Your one-time OTP is</h2>
      <p
        style="
          border: 2px solid black;
          text-align: center;
          justify-content: center;
          margin: auto;
          height: 31px;
          display: flex;
          width: 20%;
          border-radius: 5%;
        "
      >
        <span style="margin: auto"><%=otp%></span>
      </p>
      <br /><br />
      <p
        style="
          text-align: center;
          justify-content: center;
          margin: auto;
          width: 37%;
        "
      >
        Please verify you're really you by entering this OTP when you sign in.
        Just a heads up, this OTP will expire in 20 minutes for security
        reasons.
      </p>
    </div>
  </body>
</html>
